generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────────

enum Role {
  SUPERADMIN
  ADMIN
  MANAGER
  EMPLOYEE
}

enum SDGGoal {
  NO_POVERTY
  ZERO_HUNGER
  GOOD_HEALTH
  QUALITY_EDUCATION
  GENDER_EQUALITY
  CLEAN_WATER
  CLEAN_ENERGY
  DECENT_WORK
  INDUSTRY_INNOVATION
  REDUCED_INEQUALITIES
  SUSTAINABLE_CITIES
  RESPONSIBLE_CONSUMPTION
  CLIMATE_ACTION
  LIFE_BELOW_WATER
  LIFE_ON_LAND
  PEACE_JUSTICE
  PARTNERSHIPS
}

enum CSRStatus {
  DRAFT
  PUBLISHED
  REGISTRATION_CLOSED
  ONGOING
  COMPLETED
  ARCHIVED
}

enum ParticipationStatus {
  REGISTERED
  PROOF_UPLOADED
  UNDER_REVIEW
  APPROVED
  REJECTED
  WITHDRAWN
}

enum TrainingStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum FeedbackType {
  SUGGESTION
  COMPLAINT
  IDEA
  APPRECIATION
}

enum FeedbackStatus {
  SUBMITTED
  HR_REVIEW
  ASSIGNED
  RESOLVED
  CLOSED
}

enum NotificationType {
  CSR_PUBLISHED
  REGISTRATION_APPROVED
  REGISTRATION_REJECTED
  TRAINING_ASSIGNED
  PROOF_APPROVED
  BADGE_EARNED
  XP_UPDATED
  PROOF_REJECTED
  CSR_REMINDER
  TRAINING_DUE
}

enum CategoryType {
  CSR
  TRAINING
  FEEDBACK
}

enum BadgeTriggerType {
  CSR_COUNT
  VOLUNTEER_HOURS
  FEEDBACK_COUNT
  TRAINING_COUNT
  XP_TOTAL
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  STATUS_CHANGE
  LOGIN
  LOGOUT
  EXPORT
}

// ─────────────────────────────────────────────────────────────────────────────
// CORE MODELS
// ─────────────────────────────────────────────────────────────────────────────

model Department {
  id        String   @id @default(cuid())
  name      String   @unique
  code      String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  head              User?                @relation("DeptHead", fields: [headId], references: [id])
  headId            String?
  users             User[]               @relation("UserDept")
  csrActivities     CSRActivity[]
  participations    EmployeeParticipation[]
  trainings         Training[]
  feedbacks         Feedback[]
  diversityMetrics  DiversityMetric[]

  @@index([code])
  @@map("departments")
}

model Category {
  id        String       @id @default(cuid())
  name      String
  type      CategoryType
  createdAt DateTime     @default(now())

  // Relations
  csrActivities CSRActivity[]
  trainings     Training[]

  @@unique([name, type])
  @@map("categories")
}

model User {
  id          String    @id @default(cuid())
  name        String
  email       String    @unique
  password    String
  role        Role      @default(EMPLOYEE)
  avatarUrl   String?
  xpTotal     Int       @default(0)
  level       Int       @default(1)
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  deletedAt   DateTime?

  // Department relation
  department   Department? @relation("UserDept", fields: [departmentId], references: [id])
  departmentId String?

  // Relations
  deptLed            Department[]            @relation("DeptHead")
  createdCSRs        CSRActivity[]           @relation("CSRCreator")
  organizedCSRs      CSRActivity[]           @relation("CSROrganizer")
  participations     EmployeeParticipation[] @relation("ParticipantUser")
  reviewedParticipations EmployeeParticipation[] @relation("ReviewerUser")
  trainingsCreated   Training[]
  trainingCompletions TrainingCompletion[]
  feedbacks          Feedback[]              @relation("FeedbackSubmitter")
  assignedFeedbacks  Feedback[]              @relation("FeedbackAssignee")
  notifications      Notification[]
  badges             UserBadge[]
  xpHistory          XPHistory[]
  auditLogs          AuditLog[]

  @@index([email])
  @@index([departmentId])
  @@index([role])
  @@map("users")
}

// ─────────────────────────────────────────────────────────────────────────────
// CSR MODULE
// ─────────────────────────────────────────────────────────────────────────────

model CSRActivity {
  id                   String    @id @default(cuid())
  title                String
  description          String
  categoryId           String
  departmentId         String?
  sdgGoal              SDGGoal
  organizerId          String
  eventDate            DateTime
  registrationDeadline DateTime
  venue                String
  maxParticipants      Int
  bannerImage          String?
  status               CSRStatus @default(DRAFT)
  evidenceRequired     Boolean   @default(false)
  createdById          String
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt
  deletedAt            DateTime?

  // Relations
  category     Category  @relation(fields: [categoryId], references: [id])
  department   Department? @relation(fields: [departmentId], references: [id])
  organizer    User      @relation("CSROrganizer", fields: [organizerId], references: [id])
  createdBy    User      @relation("CSRCreator", fields: [createdById], references: [id])
  participations EmployeeParticipation[]

  @@index([status])
  @@index([eventDate])
  @@index([departmentId])
  @@index([categoryId])
  @@index([deletedAt])
  @@map("csr_activities")
}

model EmployeeParticipation {
  id               String              @id @default(cuid())
  userId           String
  csrActivityId    String
  departmentId     String?
  registrationDate DateTime            @default(now())
  proofDocument    String?
  proofUploadedAt  DateTime?
  approvalStatus   ParticipationStatus @default(REGISTERED)
  completionDate   DateTime?
  volunteerHours   Float?
  xpEarned         Int                 @default(0)
  certificateUrl   String?
  reviewedById     String?
  reviewNote       String?
  reviewedAt       DateTime?
  createdAt        DateTime            @default(now())
  updatedAt        DateTime            @updatedAt

  // Relations
  user        User        @relation("ParticipantUser", fields: [userId], references: [id])
  csrActivity CSRActivity @relation(fields: [csrActivityId], references: [id])
  department  Department? @relation(fields: [departmentId], references: [id])
  reviewedBy  User?       @relation("ReviewerUser", fields: [reviewedById], references: [id])

  @@unique([userId, csrActivityId])
  @@index([userId])
  @@index([csrActivityId])
  @@index([approvalStatus])
  @@index([departmentId])
  @@map("employee_participations")
}

// ─────────────────────────────────────────────────────────────────────────────
// TRAINING MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Training {
  id           String   @id @default(cuid())
  name         String
  description  String?
  categoryId   String
  departmentId String?
  assignedDate DateTime @default(now())
  dueDate      DateTime
  totalModules Int      @default(1)
  createdById  String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Relations
  category    Category   @relation(fields: [categoryId], references: [id])
  department  Department? @relation(fields: [departmentId], references: [id])
  createdBy   User       @relation(fields: [createdById], references: [id])
  completions TrainingCompletion[]

  @@index([categoryId])
  @@index([departmentId])
  @@index([dueDate])
  @@map("trainings")
}

model TrainingCompletion {
  id                   String         @id @default(cuid())
  trainingId           String
  userId               String
  completionStatus     TrainingStatus @default(NOT_STARTED)
  completedModules     Int            @default(0)
  completionPercentage Float          @default(0)
  completionDate       DateTime?
  certificateUrl       String?
  xpEarned             Int            @default(0)
  createdAt            DateTime       @default(now())
  updatedAt            DateTime       @updatedAt

  // Relations
  training Training @relation(fields: [trainingId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id])

  @@unique([trainingId, userId])
  @@index([userId])
  @@index([completionStatus])
  @@map("training_completions")
}

// ─────────────────────────────────────────────────────────────────────────────
// DIVERSITY MODULE
// ─────────────────────────────────────────────────────────────────────────────

model DiversityMetric {
  id             String   @id @default(cuid())
  departmentId   String
  year           Int
  month          Int
  totalEmployees Int      @default(0)

  // Gender
  maleCount        Int @default(0)
  femaleCount      Int @default(0)
  otherGenderCount Int @default(0)

  // Age groups
  ageGroup18_30 Int @default(0)
  ageGroup31_45 Int @default(0)
  ageGroup46Plus Int @default(0)

  // Leadership
  leadershipMale   Int @default(0)
  leadershipFemale Int @default(0)
  leadershipOther  Int @default(0)

  // Hiring
  hiringMale   Int @default(0)
  hiringFemale Int @default(0)
  hiringOther  Int @default(0)

  // Promotions
  promotionMale   Int @default(0)
  promotionFemale Int @default(0)
  promotionOther  Int @default(0)

  // Disability
  disabilityCount Int   @default(0)
  diversityScore  Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  department Department @relation(fields: [departmentId], references: [id])

  @@unique([departmentId, year, month])
  @@index([departmentId])
  @@index([year, month])
  @@map("diversity_metrics")
}

// ─────────────────────────────────────────────────────────────────────────────
// FEEDBACK MODULE
// ─────────────────────────────────────────────────────────────────────────────

model Feedback {
  id             String         @id @default(cuid())
  type           FeedbackType
  isAnonymous    Boolean        @default(false)
  content        String
  submittedById  String?
  departmentId   String?
  status         FeedbackStatus @default(SUBMITTED)
  assignedToId   String?
  resolutionNote String?
  resolvedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  // Relations
  submittedBy Department? @relation(fields: [departmentId], references: [id])
  submitter   User?      @relation("FeedbackSubmitter", fields: [submittedById], references: [id])
  assignedTo  User?      @relation("FeedbackAssignee", fields: [assignedToId], references: [id])

  @@index([status])
  @@index([type])
  @@index([submittedById])
  @@index([departmentId])
  @@map("feedbacks")
}

// ─────────────────────────────────────────────────────────────────────────────
// NOTIFICATIONS
// ─────────────────────────────────────────────────────────────────────────────

model Notification {
  id            String           @id @default(cuid())
  userId        String
  title         String
  message       String
  type          NotificationType
  referenceId   String?
  referenceType String?
  isRead        Boolean          @default(false)
  emailSent     Boolean          @default(false)
  createdAt     DateTime         @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId])
  @@index([createdAt])
  @@map("notifications")
}

// ─────────────────────────────────────────────────────────────────────────────
// GAMIFICATION
// ─────────────────────────────────────────────────────────────────────────────

model Badge {
  id               String           @id @default(cuid())
  name             String           @unique
  slug             String           @unique
  description      String
  iconUrl          String?
  xpReward         Int              @default(0)
  triggerType      BadgeTriggerType
  triggerThreshold Int
  createdAt        DateTime         @default(now())

  // Relations
  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id        String   @id @default(cuid())
  userId    String
  badgeId   String
  awardedAt DateTime @default(now())

  // Relations
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

model XPHistory {
  id            String   @id @default(cuid())
  userId        String
  xpAmount      Int
  reason        String
  referenceId   String?
  referenceType String?
  createdAt     DateTime @default(now())

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  @@map("xp_history")
}

// ─────────────────────────────────────────────────────────────────────────────
// AUDIT LOG
// ─────────────────────────────────────────────────────────────────────────────

model AuditLog {
  id        String      @id @default(cuid())
  userId    String?
  action    AuditAction
  entity    String
  entityId  String?
  meta      Json?
  ipAddress String?
  userAgent String?
  createdAt DateTime    @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entity, entityId])
  @@index([createdAt])
  @@map("audit_logs")
}
