{
  "compilerOptions": {
    "target": "ES2022",
    "module": "Node16",
    "moduleResolution": "Node16",
    "lib": ["ES2022"],
    "allowJs": true,
    "outDir": "./dist",
    "rootDir": "./"
  },
  "include": [
    "app.ts",
    "config/**/*",
    "middleware/**/*",
    "modules/**/*",
    "routes/**/*",
    "utils/**/*",
    "scratch/**/*"
  ]
}
